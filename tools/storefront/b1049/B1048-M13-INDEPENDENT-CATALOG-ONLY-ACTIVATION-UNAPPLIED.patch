diff --git a/apps/cms/current/app/Support/PublicCatalogReadOnlyGate.php b/apps/cms/current/app/Support/PublicCatalogReadOnlyGate.php
new file mode 100644
index 0000000..1700377
--- /dev/null
+++ b/apps/cms/current/app/Support/PublicCatalogReadOnlyGate.php
@@ -0,0 +1,63 @@
+<?php
+declare(strict_types=1);
+
+namespace App\Support;
+
+/**
+ * B1048 M13-only fail-closed route and flag gate.
+ * NOT a buyer session gate and NOT permission to accept an order.
+ * Exact GET-only M13 routes and two independent OFF-by-default switches required.
+ */
+final class PublicCatalogReadOnlyGate
+{
+    /**
+     * @param iterable<array{name:string,uri:string,methods:array,middleware:array}> $routes
+     */
+    public static function permits(
+        bool $catalogEnvironmentEnabled,
+        bool $catalogDatabaseOpen,
+        bool $legacyStorefrontEnvironmentEnabled,
+        bool $legacyStorefrontDatabaseOpen,
+        bool $checkoutEnvironmentEnabled,
+        iterable $routes
+    ): bool {
+        if (!$catalogEnvironmentEnabled || !$catalogDatabaseOpen
+            || $legacyStorefrontEnvironmentEnabled || $legacyStorefrontDatabaseOpen
+            || $checkoutEnvironmentEnabled) {
+            return false;
+        }
+
+        $expected = [
+            'public-shop.catalog' => ['katalog', 'public-shop-browse'],
+            'public-shop.show' => ['katalog/{slug}', 'public-shop-browse'],
+            'public-shop.media' => ['katalog/slika/{image}', 'public-shop-images'],
+        ];
+        $seen = [];
+        foreach ($routes as $route) {
+            if (!is_array($route)) return false;
+            $name = (string) ($route['name'] ?? '');
+            $uri = ltrim((string) ($route['uri'] ?? ''), '/');
+            $methods = $route['methods'] ?? [];
+            $middleware = $route['middleware'] ?? [];
+            if (!is_array($methods) || !is_array($middleware)) return false;
+
+            // The M13-only gate fails closed even if old purchase routes
+            // have no public-shop.* names (historically /korpa etc.).
+            if (preg_match('#^(?:korpa|porucivanje|registracija)(?:/|$)#i', $uri)) return false;
+            if (!str_starts_with($name, 'public-shop.')) continue;
+            if (!isset($expected[$name]) || isset($seen[$name])) return false;
+            [$targetUri, $throttle] = $expected[$name];
+            if ($uri !== $targetUri) return false;
+            if (array_diff($methods, ['GET','HEAD']) !== [] || !in_array('GET', $methods, true)) {
+                return false;
+            }
+            $short = 'throttle:'.$throttle;
+            $expanded = 'Illuminate\\Routing\\Middleware\\ThrottleRequests:'.$throttle;
+            if (!in_array($short, $middleware, true) && !in_array($expanded, $middleware, true)) {
+                return false;
+            }
+            $seen[$name] = true;
+        }
+        return count($seen) === count($expected);
+    }
+}
