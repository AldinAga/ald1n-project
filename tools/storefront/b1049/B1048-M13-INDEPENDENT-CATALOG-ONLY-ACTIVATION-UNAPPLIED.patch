+        foreach (\Illuminate\Support\Facades\Route::getRoutes() as $route) {
+            $routes[] = [
+                'name' => (string) ($route->getName() ?? ''),
+                'uri' => (string) $route->uri(),
+                'methods' => $route->methods(),
+                'middleware' => $route->gatherMiddleware(),
+            ];
+        }
+        return \App\Support\PublicCatalogReadOnlyGate::permits(
+            config('public_storefront.catalog_readonly_enabled') === true,
+            $this->requestedCatalogReadOnlyOpen(),
+            config('public_storefront.enabled') === true,
+            $this->requestedOpen(),
+            config('public_storefront.checkout_enabled') === true,
+            $routes
