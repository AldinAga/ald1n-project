diff --git a/apps/cms/current/app/Services/PublicMerchantPolicyService.php b/apps/cms/current/app/Services/PublicMerchantPolicyService.php
new file mode 100644
index 00000000..7d296747
--- /dev/null
+++ b/apps/cms/current/app/Services/PublicMerchantPolicyService.php
@@ -0,0 +1,143 @@
+<?php
+declare(strict_types=1);
+
+namespace App\Services;
+
+use App\Models\BankAccount;
+use App\Models\User;
+
+/**
+ * Owner-attested merchant configuration. Never infer delivery, legal or payment
+ * conditions from the presence of an old PDF/company profile.
+ *
+ * The two public-facing ENV flags remain independent OFF-by-default release
+ * gates. Saving/approving a policy NEVER enables the public storefront.
+ */
+final class PublicMerchantPolicyService
+{
+    private const STORED = [
+        'terms_url','privacy_url','shipping_fee_rsd','shipping_description',
+        'payment_methods','support_email','bank_account_id',
+        'delivery_methods',
+    ];
+
+    public function __construct(private readonly SettingsService $settings) {}
+
+    /** @return array<string,mixed> */
+    public function policy(): array
+    {
+        $value = [];
+        foreach (self::STORED as $key) {
+            $config = config('public_storefront.'.$key);
+            $storedKey = 'public_checkout_'.$key;
+            if ($this->settings->hasStoredValue($storedKey)) {
+                $raw = (string) $this->settings->get($storedKey,'');
+            } elseif (is_array($config)) {
+                $raw = implode(',', $config);
+            } else {
+                $raw = trim((string) $config);
+            }
+            $value[$key] = trim($raw);
+        }
+        $value['methods'] = array_values(array_unique(array_filter(
+            array_map('trim', explode(',', $value['payment_methods'])),
+            static fn (string $name): bool => $name !== ''
+        )));
+        sort($value['methods'], SORT_STRING);
+        $value['deliveries']=array_values(array_unique(array_filter(array_map('trim',explode(',',$value['delivery_methods'])))));
+        sort($value['deliveries'],SORT_STRING);
+        $value['company_name'] = trim((string)$this->settings->get('documents_company_name',''));
+        $value['company_address'] = trim((string)$this->settings->get('documents_company_address',''));
+        $value['company_city'] = trim((string)$this->settings->get('documents_company_city',''));
+        $value['company_tax_id'] = trim((string)$this->settings->get('documents_company_tax_id',''));
+        return $value;
+    }
+
+    /**
+     * Only the policies and merchant identity are included. Approval is
+     * invalidated by EVERY subsequent policy, contact, identity or method edit.
+     * No buyer PII, payment account number or secret is part of this snapshot.
+     */
+    public function fingerprint(?array $policy = null): string
+    {
+        $policy ??= $this->policy();
+        unset($policy['methods'],$policy['deliveries']);
+        return hash('sha256', json_encode($policy,
+            JSON_THROW_ON_ERROR | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES));
+    }
+
+    /**
+     * Inspection does not enable checkout, send mail, alter settings, query live
+     * external sites or attest legal content. UI may display missing settings.
+     *
+     * @return array{policy:array<string,mixed>,issues:list<string>,complete:bool,approved:bool,fingerprint:string,bank_account:?BankAccount}
+     */
+    public function review(): array
+    {
+        $p = $this->policy();
+        $issues = [];
+        if ($p['company_name'] === '' || in_array($p['company_name'], ['Ald1n','Ald1n CMS'], true)
+            || $p['company_address'] === '' || $p['company_city'] === '' || $p['company_tax_id'] === '') {
+            $issues[]='Unesi stvarni naziv, adresu, grad i PIB trgovca u PDF podešavanjima.';
+        }
+        if (!$this->safeLegalUrl($p['terms_url'])) $issues[]='Nedostaje validna HTTPS adresa uslova prodaje.';
+        if (!$this->safeLegalUrl($p['privacy_url'])) $issues[]='Nedostaje validna HTTPS adresa politike privatnosti.';
+        if ($p['shipping_description'] === '') $issues[]='Unesi stvarne uslove dostave.';
+        // Current existing orders have no independent shipping fee ledger.
+        if (!preg_match('/^0(?:\.0{1,2})?$/D', $p['shipping_fee_rsd'])) {
+            $issues[]='Trošak dostave mora biti izričito odobren kao 0 RSD. Naplata dostave još nije podržana.';
+        }
+        if (!filter_var($p['support_email'], FILTER_VALIDATE_EMAIL)) {
+            $issues[]='Unesi validan e-mail za podršku kupcima.';
+        }
+        if ($p['methods'] === [] || array_diff($p['methods'], array_keys(\App\Support\PublicRetailOptions::PAYMENT)) !== []) {
+            $issues[]='Izaberi podržani način plaćanja.';
+        }
+        if ($p['deliveries']===[] || array_diff($p['deliveries'],array_keys(\App\Support\PublicRetailOptions::DELIVERY))!==[]) {
+            $issues[]='Izaberi postojece nacine dostave dostupne kupcu.';
+        }
+        if (in_array('cash',$p['methods'],true)
+            && array_intersect($p['deliveries'],['customer_pickup','own_transport'])===[]) {
+            $issues[]='Placanje pri preuzimanju zahteva licno preuzimanje ili sopstvenu dostavu.';
+        }
+        $bank = null;
+        if (in_array('bank_transfer', $p['methods'], true)) {
+            $id = filter_var($p['bank_account_id'], FILTER_VALIDATE_INT);
+            $bank = $id && $id > 0
+                ? BankAccount::query()->whereKey($id)->where('is_active', true)->first()
+                : null;
+            if (!$bank instanceof BankAccount) $issues[]='Za bankovni transfer izaberi aktivan žiro račun.';
+        }
+        $fingerprint = $this->fingerprint($p);
+        $digest = trim((string)$this->settings->get('public_checkout_approval_digest',''));
+        $by = filter_var($this->settings->get('public_checkout_approved_by',''), FILTER_VALIDATE_INT);
+        $at = trim((string)$this->settings->get('public_checkout_approved_at',''));
+        $approved = $issues === [] && $digest !== '' && hash_equals($digest,$fingerprint)
+            && $at !== '' && $by && $by > 0
+            && User::query()->whereKey($by)->where('status','active')->whereNull('retired_at')
+                ->whereHas('role', static fn ($query) => $query->where('slug','superadmin'))
+                ->exists();
+        return [
+            'policy'=>$p,'issues'=>$issues,'complete'=>$issues === [],
+            'approved'=>$approved,'fingerprint'=>$fingerprint,'bank_account'=>$bank,
+        ];
+    }
+
+    private function safeLegalUrl(string $url): bool
+    {
+        if ($url === '' || (preg_match('/[\x00-\x20\x7f]/', $url) || str_contains($url, '\\'))
+            || !filter_var($url, FILTER_VALIDATE_URL)) return false;
+        $parts=parse_url($url);
+        if (!is_array($parts) || strtolower((string)($parts['scheme']??''))!=='https'
+            || isset($parts['user']) || isset($parts['pass'])
+            || isset($parts['port'])) return false;
+        $host=strtolower((string)($parts['host']??''));
+        return $host !== '' && !str_ends_with($host,'.') && str_contains($host,'.')
+            && filter_var($host,FILTER_VALIDATE_IP)===false
+            && filter_var($host,FILTER_VALIDATE_DOMAIN,FILTER_FLAG_HOSTNAME)!==false
+            && !preg_match('/\.(?:[0-9]+|0x[0-9a-f]+)$/iD',$host)
+            && !preg_match('/(?:^|\.)(?:localhost|local|internal)$/D',$host)
+            && !(app()->environment('production')
+                && preg_match('/\.(?:test|invalid|example|localhost)$/D',$host));
+    }
+}
diff --git a/apps/cms/current/app/Services/PublicRetailCatalogService.php b/apps/cms/current/app/Services/PublicRetailCatalogService.php
new file mode 100644
index 00000000..185ae078
--- /dev/null
+++ b/apps/cms/current/app/Services/PublicRetailCatalogService.php
@@ -0,0 +1,135 @@
+<?php
+declare(strict_types=1);
+
+namespace App\Services;
+
+use App\Models\Brand;
+use App\Models\Category;
+use App\Models\Product;
+use Illuminate\Database\Eloquent\Builder;
+use Illuminate\Pagination\LengthAwarePaginator;
+use Illuminate\Validation\ValidationException;
+
+final class PublicRetailCatalogService
+{
+    public function __construct(private readonly SettingsService $settings) {}
+
+    /** @return Builder<Product> */
+    public function available(): Builder
+    {
+        // Strict public allowlist: never inherit a logged-in user's catalog scope.
+        return Product::query()->select([
+            'id', 'slug', 'sku', 'name', 'description', 'model_name',
+            'price_amount', 'price_currency', 'stock_quantity', 'brand_id',
+            'product_type_id', 'status', 'deleted_at', 'created_at',
+        ])->publiclyVisible()->where('price_amount', '>', 0);
+    }
+
+    /** @param array<string,mixed> $filters */
+    public function search(array $filters): LengthAwarePaginator
+    {
+        $q = trim((string) ($filters['q'] ?? ''));
+        $query = $this->available()->with([
+            'brand:id,name', 'images:id,product_id',
+        ]);
+        if ($q !== '') {
+            $term = '%'.addcslashes(mb_substr($q, 0, 80), '\\%_').'%';
+            $query->where(static fn (Builder $inner): Builder => $inner
+                ->where('name', 'like', $term)
+                ->orWhere('sku', 'like', $term)
+                ->orWhere('model_name', 'like', $term));
+        }
+        if ((int) ($filters['brand_id'] ?? 0) > 0) {
+            $query->where('brand_id', (int) $filters['brand_id']);
+        }
+        if ((int) ($filters['category_id'] ?? 0) > 0) {
+            $categoryId = (int) $filters['category_id'];
+            $query->whereHas('categories', static fn (Builder $category): Builder => $category
+                ->where('categories.status', 'active')->whereKey($categoryId));
+        }
+        if (($filters['stock'] ?? null) === 'available') {
+            $query->where('stock_quantity', '>', 0);
+        }
+        switch ($filters['sort'] ?? '') {
+            case 'name':
+                $query->orderBy('name')->orderBy('id'); break;
+            default:
+                $query->orderByDesc('id');
+        }
+        // B901: the paginator otherwise derives an absolute site origin.
+        // Internal page links and filter state must stay on the current origin,
+        // independent of Host/proxy headers and deploy-time APP_URL.
+        return $query->paginate(20)
+            ->withPath(route('public-shop.catalog', [], false))
+            ->withQueryString();
+    }
+
+    public function bySlug(string $slug): Product
+    {
+        return $this->available()->where('slug', $slug)
+            ->with(['brand:id,name','images:id,product_id',
+                'specificationValues.field', 'categories:id,name,status'])->firstOrFail();
+    }
+
+    public function byId(int $id): Product
+    {
+        return $this->available()->whereKey($id)
+            ->with(['brand:id,name','images:id,product_id'])->firstOrFail();
+    }
+
+    /** @return array<string,mixed> Public presentation ONLY; no commissions/costs/creator */
+    public function present(Product $product): array
+    {
+        $unit = $this->priceRsd($product);
+        $image = $product->images->first();
+        return [
+            'id' => (int) $product->id,
+            'slug' => (string) $product->slug,
+            'name' => (string) $product->name,
+            'sku' => (string) $product->sku,
+            'description' => (string) ($product->description ?? ''),
+            'brand' => (string) ($product->brand?->name ?? ''),
+            'stock' => max(0,(int) $product->stock_quantity),
+            'price_original' => number_format((float) $product->price_amount, 2, ',', '.'),
+            'currency' => (string) $product->price_currency,
+            'price_rsd' => $unit,
+            'can_buy' => $unit !== null && $unit > 0 && (int) $product->stock_quantity > 0,
+            'image' => $image ? route('public-shop.media', ['image' => $image->id], false) : null,
+        ];
+    }
+
+    public function priceRsd(Product $product): ?float
+    {
+        $amount = (float) $product->price_amount;
+        if (!is_finite($amount) || $amount <= 0) return null;
+        if ((string) $product->price_currency === 'RSD') return round($amount, 2);
+        if ((string) $product->price_currency !== 'EUR') return null;
+        $rate = $this->settings->eurRsdRate();
+        if ($rate === null || $rate <= 0) return null;
+        return round($amount * $rate, 2);
+    }
+
+    public function requirePurchasable(Product $product, int $quantity): float
+    {
+        $price = $this->priceRsd($product);
+        if ($price === null || (int) $product->stock_quantity < $quantity || $quantity < 1) {
+            throw ValidationException::withMessages([
+                'cart' => 'Izabrani artikal trenutno nije raspoloživ ili cena nije podešena.',
+            ]);
+        }
+        return $price;
+    }
+
+    /** @return array{brands:mixed,categories:mixed} */
+    public function filters(): array
+    {
+        return [
+            'brands' => Brand::query()->where('status','active')->whereHas('products',
+                static fn (Builder $q) => $q->publiclyVisible()->where('price_amount','>',0)
+            )->orderBy('name')->get(['id','name']),
+            'categories' => Category::query()->where('status','active')->whereHas('products',
+                static fn (Builder $q) => $q->publiclyVisible()->where('price_amount','>',0)
+            )->orderBy('name')->get(['id','name']),
+        ];
+    }
+}
diff --git a/apps/cms/current/app/Services/PublicStorefrontStateService.php b/apps/cms/current/app/Services/PublicStorefrontStateService.php
new file mode 100644
index 00000000..0f84d785
--- /dev/null
+++ b/apps/cms/current/app/Services/PublicStorefrontStateService.php
@@ -0,0 +1,100 @@
+<?php
+declare(strict_types=1);
+namespace App\Services;
+
+use App\Models\Setting;
+use App\Models\User;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Schema;
+use Illuminate\Validation\ValidationException;
+
+final class PublicStorefrontStateService
+{
+    public function __construct(
+        private readonly SettingsService $settings,
+        private readonly PublicMerchantPolicyService $merchant,
+        private readonly AuditLogger $audit,
+    ) {}
+
+    public function requestedOpen(bool $lock = false): bool
+    {
+        if (!Schema::hasTable('settings')) return false;
+        // Do not use the settings cache for the emergency OFF control.
+        $row=Setting::query()->where('setting_key','public_storefront_open');
+        if ($lock) $row->sharedLock();
+        return (string)$row->value('setting_value') === '1';
+    }
+
+    public function isOpen(bool $lock = false): bool
+    {
+        return config('public_storefront.enabled') === true && $this->requestedOpen($lock);
+    }
+
+    /** M13 separate public catalog control. Reading it NEVER changes checkout permissions. */
+    public function requestedCatalogReadOnlyOpen(): bool
+    {
+        if (!Schema::hasTable('settings')) return false;
+        // Avoid a cached value so emergency OFF revokes the next request.
+        return (string) Setting::query()->where('setting_key', 'public_catalog_readonly_open')
+            ->value('setting_value') === '1';
+    }
+
+    /**
+     * The M13 catalog cannot accidentally inherit the old all-or-nothing shop
+     * switch or future M14/M15 shopping routes. No new admin endpoint is wired.
+     * A production ON action still requires distinct explicit authorization.
+     */
+    public function isCatalogReadOnlyOpen(): bool
+    {
+        $routes = [];
+        foreach (\Illuminate\Support\Facades\Route::getRoutes() as $route) {
+            $routes[] = [
+                'name' => (string) ($route->getName() ?? ''),
+                'uri' => (string) $route->uri(),
+                'methods' => $route->methods(),
+                'middleware' => $route->gatherMiddleware(),
+            ];
+        }
+        return \App\Support\PublicCatalogReadOnlyGate::permits(
+            config('public_storefront.catalog_readonly_enabled') === true,
+            $this->requestedCatalogReadOnlyOpen(),
+            config('public_storefront.enabled') === true,
+            $this->requestedOpen(),
+            config('public_storefront.checkout_enabled') === true,
+            $routes
+        );
+    }
+
+    public function change(bool $open, User $actor): void
+    {
+        abort_unless($actor->status === 'active' && $actor->retired_at === null
+            && $actor->hasRole('superadmin'),403);
+        try {
+            DB::transaction(function () use ($open,$actor): void {
+                Setting::query()->firstOrCreate(['setting_key'=>'public_storefront_open'],[
+                    'setting_value'=>'0','updated_by'=>$actor->id,
+                ]);
+                $state=Setting::query()->where('setting_key','public_storefront_open')->lockForUpdate()->firstOrFail();
+                if ($open) {
+                    $review=$this->merchant->review();
+                    $schema=Schema::hasTable('public_order_accesses')
+                        && Schema::hasColumns('public_checkout_attempts',[
+                            'merchant_policy_digest','delivery_method','customer_user_id','payment_due_at_snapshot',
+                        ]);
+                    if (config('public_storefront.enabled')!==true
+                        || config('public_storefront.checkout_enabled')!==true
+                        || !$schema || !$review['approved']) {
+                        throw ValidationException::withMessages(['enabled'=>
+                            'ON zahteva isporucen kod, spremnu bazu i potvrdjene uslove trgovca.']);
+                    }
+                }
+                $before=(string)$state->setting_value === '1';
+                $state->update(['setting_value'=>$open?'1':'0','updated_by'=>$actor->id]);
+                $this->audit->log('settings.public_storefront_toggled','Javna prodavnica ON / OFF',
+                    null,['enabled'=>$before],['enabled'=>$open],user:$actor);
+            },5);
+        } finally {
+            $this->settings->forgetCache();
+        }
+    }
+}
diff --git a/apps/cms/current/app/Support/PublicCatalogReadOnlyGate.php b/apps/cms/current/app/Support/PublicCatalogReadOnlyGate.php
new file mode 100644
index 00000000..e087ddd1
--- /dev/null
+++ b/apps/cms/current/app/Support/PublicCatalogReadOnlyGate.php
@@ -0,0 +1,69 @@
+<?php
+declare(strict_types=1);
+
+namespace App\Support;
+
+/**
+ * B1048 M13-only fail-closed route and flag gate.
+ * NOT a buyer session gate and NOT permission to accept an order.
+ * Exact GET-only M13 routes and two independent OFF-by-default switches required.
+ */
+final class PublicCatalogReadOnlyGate
+{
+    /**
+     * @param iterable<array{name:string,uri:string,methods:array,middleware:array}> $routes
+     */
+    public static function permits(
+        bool $catalogEnvironmentEnabled,
+        bool $catalogDatabaseOpen,
+        bool $legacyStorefrontEnvironmentEnabled,
+        bool $legacyStorefrontDatabaseOpen,
+        bool $checkoutEnvironmentEnabled,
+        iterable $routes
+    ): bool {
+        if (!$catalogEnvironmentEnabled || !$catalogDatabaseOpen
+            || $legacyStorefrontEnvironmentEnabled || $legacyStorefrontDatabaseOpen
+            || $checkoutEnvironmentEnabled) {
+            return false;
+        }
+
+        $expected = [
+            'public-shop.catalog' => ['katalog', 'public-shop-browse'],
+            'public-shop.show' => ['katalog/{slug}', 'public-shop-browse'],
+            'public-shop.media' => ['katalog/slika/{image}', 'public-shop-images'],
+        ];
+        $seen = [];
+        foreach ($routes as $route) {
+            if (!is_array($route)) return false;
+            $name = (string) ($route['name'] ?? '');
+            $uri = ltrim((string) ($route['uri'] ?? ''), '/');
+            $methods = $route['methods'] ?? [];
+            $middleware = $route['middleware'] ?? [];
+            if (!is_array($methods) || !is_array($middleware)) return false;
+
+            // The M13-only gate fails closed even if old purchase routes
+            // have no public-shop.* names (historically /korpa etc.).
+            if (preg_match('#^(?:korpa|porucivanje|registracija|checkout|kupovina)(?:/|$)#i', $uri)) return false;
+            // Reject unnamed or differently named handlers under /katalog as
+            // well: otherwise /katalog/checkout POST could bypass the census.
+            // This is route review, not a replacement for M14/M15 authorization.
+            if ($uri === 'katalog' || str_starts_with($uri, 'katalog/')) {
+                if (!isset($expected[$name])) return false;
+            }
+            if (!str_starts_with($name, 'public-shop.')) continue;
+            if (!isset($expected[$name]) || isset($seen[$name])) return false;
+            [$targetUri, $throttle] = $expected[$name];
+            if ($uri !== $targetUri) return false;
+            if (array_diff($methods, ['GET','HEAD']) !== [] || !in_array('GET', $methods, true)) {
+                return false;
+            }
+            $short = 'throttle:'.$throttle;
+            $expanded = 'Illuminate\\Routing\\Middleware\\ThrottleRequests:'.$throttle;
+            if (!in_array($short, $middleware, true) && !in_array($expanded, $middleware, true)) {
+                return false;
+            }
+            $seen[$name] = true;
+        }
+        return count($seen) === count($expected);
+    }
+}
