 declare(strict_types=1);
 
 /**
- * Only validates an explicitly specified isolated candidate's contents.
- * No production checkout, credentials, storage or vendor directory access.
+ * Verify a complete, independently pinned snapshot of isolated PHP source.
+ * The expected filenames must come from a trusted caller, not from $pins.
  */
 final class SourceManifestValidator
 {
-    /** @param array<string,string> $pins */
-    public static function verify(string $root, array $pins): int
+    /**
+     * @param array<string,string> $pins Exact SHA-256 hex digests by relative path.
+     * @param list<string> $expectedPaths Independently pinned complete PHP inventory.
+     */
+    public static function verify(string $root, array $pins, array $expectedPaths): int
     {
-        if ($pins === [] || !is_dir($root) || is_link($root)) {
-            throw new \InvalidArgumentException('Empty source manifest or invalid isolated root.');
-        }
-        $checked=0;
-        foreach ($pins as $relative => $expected) {
-            if (!is_string($relative)
-                || !str_starts_with($relative, 'candidate/')
-                || !preg_match('~\A[a-zA-Z0-9_-]+(?:/[a-zA-Z0-9_.-]+)*\.php\z~D', $relative)
-                || !preg_match('/\A[a-f0-9]{64}\z/D', $expected)) {
-                throw new \InvalidArgumentException('Unsafe or unsupported source manifest entry.');
-            }
-            $parts=explode('/',$relative);
-            $walk=$root;
-            foreach ($parts as $part) {
-                if ($part === '.' || $part === '..' || $part === '' || $part[0] === '.') {
-                    throw new \InvalidArgumentException('Unsafe path segment.');
-                }
-                $walk.='/'.$part;
-                if (is_link($walk)) {
-                    throw new \InvalidArgumentException('Source path contains symlink.');
-                }
-            }
-            if (!is_file($walk) || !hash_equals($expected, hash_file('sha256',$walk))) {
