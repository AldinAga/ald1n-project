{
  "version": 1,
  "designAuthority": "ald1n-operator-v1",
  "policy": {
    "oneFamilyPerSurface": true,
    "emojiIconsForbidden": true,
    "textPseudoFallbacksForbidden": true,
    "arbitraryInlineSvgForNewIconsForbidden": true
  },
  "mobile": {
    "authority": "expo-symbols-material-symbols",
    "iosFamily": "sf-symbols",
    "androidFamily": "material-symbols",
    "weight": "medium",
    "fallbackPolicy": "cross-platform-name-map-no-text-fallback",
    "semanticNames": [
      "home",
      "catalog",
      "add",
      "cart",
      "orders",
      "commission",
      "warranty",
      "service",
      "messages",
      "report",
      "bell",
      "account",
      "admin",
      "arrow",
      "search",
      "box",
      "refresh",
      "check",
      "close",
      "device",
      "lock",
      "info",
      "google"
    ]
  },
  "laravel": {
    "currentRuntime": "x-icon-custom-inline-svg",
    "target": "phosphor-local-bundled",
    "runtimeSwitchInThisBatch": false,
    "targetWeight": "regular",
    "strokeConsistency": "single-family",
    "currentSemanticMap": {
      "home": "house",
      "boxes": "package",
      "orders": "receipt",
      "wallet": "wallet",
      "sliders": "sliders-horizontal",
      "users": "users",
      "settings": "gear",
      "logout": "sign-out",
      "grid": "squares-four",
      "plus-circle": "plus-circle",
      "receipt": "receipt",
      "dashboard": "gauge",
      "coins": "coins",
      "bell": "bell",
      "cog": "gear-six",
      "check-circle": "check-circle",
      "money": "money",
      "cube": "cube",
      "alert": "warning",
      "x-circle": "x-circle",
      "user-check": "user-check",
      "hourglass": "hourglass",
      "user-block": "user-minus",
      "arrow-right": "arrow-right",
      "moon": "moon",
      "sun": "sun",
      "monitor": "monitor",
      "chart": "chart-line-up",
      "download": "download-simple",
      "star": "star",
      "grip": "dots-six-vertical",
      "lock": "lock",
      "health": "heartbeat",
      "shield": "shield-check",
      "file-text": "file-text",
      "chevron-left": "caret-left",
      "chevron-right": "caret-right",
      "expand": "arrows-out",
      "zoom-in": "magnifying-glass-plus",
