{
  "name": "ald1n-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-project.mjs",
    "doctor": "expo-doctor",
    "prebuild:clean": "expo prebuild --clean",
    "build:android:preview": "npx eas-cli@latest build --platform android --profile preview",
    "build:android:production": "npx eas-cli@latest build --platform android --profile production",
    "build:ios:preview": "npx eas-cli@latest build --platform ios --profile preview",
    "build:ios:production": "npx eas-cli@latest build --platform ios --profile production",
    "build:android:development": "npx eas-cli@latest build --platform android --profile development",
    "build:ios:development": "npx eas-cli@latest build --platform ios --profile development",
    "submit:android:production": "node scripts/submit-android-production.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.0",
    "@tamagui/animations-reanimated": "2.6.0",
    "@tamagui/config": "2.6.0",
    "@tanstack/react-query": "^5.90.0",
    "expo": "~57.0.26",
    "expo-application": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.24",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.62.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-google-signin": "1.0.2",
    "react-native-nitro-modules": "0.36.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tamagui": "2.6.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "expo-doctor": "^1.20.1",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "enabled": true,
        "exclude": [
          "react-native-nitro-google-signin"
        ]
      }
    }
  }
}
