{
  "cli": {
    "version": "27.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_API_URL": "https://cms.ald1n.com/api/v1"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "preview",
        "EXPO_PUBLIC_API_URL": "https://cms.ald1n.com/api/v1"
      },
      "autoIncrement": true
    },
    "ios-simulator": {
      "distribution": "internal",
      "channel": "preview",
      "autoIncrement": false,
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "preview",
        "EXPO_PUBLIC_API_URL": "https://cms.ald1n.com/api/v1"
      }
    },
    "m17-sdk58-uat": {
      "extends": "preview",
      "environment": "preview",
      "distribution": "internal",
      "channel": "m17-sdk58-uat",
      "autoIncrement": false,
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "preview",
        "EXPO_PUBLIC_API_URL": "https://cms.ald1n.com/api/v1",
        "ALD1N_M17_SDK58_UAT": "isolated",
        "ALD1N_M17_SDK58_PROFILE": "m17-sdk58-uat"
      }
    },
    "m17-sdk58-play-rc": {
      "extends": "production",
      "environment": "production",
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://cms.ald1n.com/api/v1",
        "ALD1N_M17_SDK58_PLAY_RC": "source-only",
        "ALD1N_M17_SDK58_PLAY_PROFILE": "m17-sdk58-play-rc"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://cms.ald1n.com/api/v1"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production-v15-16kb": {
      "extends": "production",
      "environment": "production",
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://cms.ald1n.com/api/v1",
        "ALD1N_V15_RELEASE_GATE": "approved",
        "ALD1N_V15_RELEASE_PROFILE": "production-v15-16kb"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "production",
        "releaseStatus": "completed"
      }
    }
  }
}
