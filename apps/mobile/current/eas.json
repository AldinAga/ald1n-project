{
  "cli": {
    "version": "25.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_API_URL": "https://cms.ald1n.com/api/v1"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "preview",
        "EXPO_PUBLIC_API_URL": "https://cms.ald1n.com/api/v1"
      },
      "autoIncrement": true
    },
    "lg03-native-uat": {
      "distribution": "internal",
      "channel": "lg03-native-uat",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "preview",
        "EXPO_PUBLIC_API_URL": "https://cms.ald1n.com/api/v1",
        "ALD1N_LG03_NATIVE_UAT": "1"
      },
      "autoIncrement": false
    },
    "lg03-play-testing": {
      "distribution": "store",
      "channel": "lg03-play-testing",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://cms.ald1n.com/api/v1",
        "ALD1N_LG03_PLAY_TESTING": "1"
      },
      "autoIncrement": true
    },
    "ios-simulator": {
      "distribution": "internal",
      "channel": "preview",
      "autoIncrement": false,
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "preview",
        "EXPO_PUBLIC_API_URL": "https://cms.ald1n.com/api/v1"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://cms.ald1n.com/api/v1"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "production",
        "releaseStatus": "completed"
      }
    }
  }
}
