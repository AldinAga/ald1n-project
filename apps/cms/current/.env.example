APP_NAME="Ald1n CMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://cms.ald1n.com
DEPLOY_PATH=/home/icaffeco/ald1n-project/apps/cms/current
APP_TIMEZONE=Europe/Belgrade
APP_LOCALE=sr_Latn
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Nova Laravel baza - READ/WRITE
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=icaffeco_lrvl
DB_USERNAME=icaffeco_lrvl
DB_PASSWORD=

# Stari CMS - obavezno poseban READ ONLY korisnik
LEGACY_DB_HOST=localhost
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=icaffeco_cms
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=
LEGACY_MEDIA_BASE_URL=https://ald1n.com/cms
LEGACY_MEDIA_ROOT=

SESSION_DRIVER=file
SESSION_CONNECTION=
SESSION_STORE=
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=cms.ald1n.com

CACHE_STORE=file
CACHE_LIMITER=file
QUEUE_CONNECTION=database
DB_QUEUE_CONNECTION=
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90
QUEUE_FAILED_DRIVER=database-uuids
FILESYSTEM_DISK=local

# Fallback vrednosti; nakon instalacije mogu se menjati kroz Podešavanja -> Cloudflare Turnstile.
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=0x4AAAAAAD4fRZTSSOfQu29m
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=cms.ald1n.com
TURNSTILE_EXPECTED_ACTION=login

SANCTUM_STATEFUL_DOMAINS=cms.ald1n.com
SANCTUM_EXPIRATION=43200

# Mobilna aplikacija (React Native / Expo)
MOBILE_PUSH_ENABLED=false
MOBILE_PUSH_PROVIDER=expo
MOBILE_PUSH_EXPO_ACCESS_TOKEN=
MOBILE_PUSH_TIMEOUT_SECONDS=10
MOBILE_PUSH_MAX_ATTEMPTS=5
MOBILE_PUSH_RECEIPT_DELAY_MINUTES=15
MOBILE_ANDROID_MIN_VERSION=1.0.0
MOBILE_ANDROID_LATEST_VERSION=1.0.0
MOBILE_ANDROID_STORE_URL=
MOBILE_IOS_MIN_VERSION=1.0.0
MOBILE_IOS_LATEST_VERSION=1.0.0
MOBILE_IOS_STORE_URL=

# E-mail za resetovanje lozinke - popuniti stvarnim SMTP nalogom
MAIL_MAILER=smtp
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TIMEOUT=15
MAIL_FROM_ADDRESS=noreply@ald1n.com
MAIL_FROM_NAME="Ald1n CMS"

# Zvanicni NBS SOAP API za EUR/RSD kurs. Kredencijale izdaje NBS; ne upisivati ih u Git.
NBS_EXCHANGE_API_USERNAME=
NBS_EXCHANGE_API_PASSWORD=
NBS_EXCHANGE_API_LICENCE_ID=
NBS_EXCHANGE_API_TIMEOUT_SECONDS=20
NBS_EXCHANGE_API_CONNECT_TIMEOUT_SECONDS=7

# Sekundarni fallback za EUR/RSD kada NBS API nije dostupan.
FRANKFURTER_EXCHANGE_API_TIMEOUT_SECONDS=12
FRANKFURTER_EXCHANGE_API_CONNECT_TIMEOUT_SECONDS=5
# Zvanični NBS IPS QR API za predračun i račun sa uplatom na račun.
NBS_IPS_QR_GENERATE_URL="https://nbs.rs/QRcode/api/qr/v1/generate/320?lang=sr_RS_Latn"
NBS_IPS_QR_TIMEOUT=20

# System health disk pragovi. Procenat sam po sebi nije kritičan na velikom shared filesystemu.
SYSTEM_HEALTH_DISK_CRITICAL_FREE_BYTES=1073741824
SYSTEM_HEALTH_DISK_WARNING_FREE_BYTES=5368709120
SYSTEM_HEALTH_DISK_CRITICAL_FREE_PERCENT=2
SYSTEM_HEALTH_DISK_WARNING_FREE_PERCENT=5
SYSTEM_HEALTH_DISK_CRITICAL_RELATIVE_MAX_FREE_BYTES=10737418240
SYSTEM_HEALTH_DISK_WARNING_RELATIVE_MAX_FREE_BYTES=53687091200

# Redis nije obavezan. Koriste se file session/cache i database queue.
# Queue worker mora stalno da radi u produkciji.

# Lokalni sendmail fallback na cPanel hostingu
MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"

# In-app notifications are always active. Enable optional email delivery only after MAIL_* is configured.
OPERATIONAL_EMAIL_NOTIFICATIONS=false

# Privatni backup sistem. Putanja mora biti izvan public direktorijuma.
BACKUP_PATH=/home/icaffeco/backups/cms.ald1n.com
BACKUP_MYSQLDUMP_BINARY=mysqldump
BACKUP_TIMEOUT_SECONDS=1800
BACKUP_DAILY_RETENTION=7
BACKUP_WEEKLY_RETENTION=4

# Phase 3C - Google login/registration. Keep disabled until Firebase SHA-1 + OAuth client are configured.
MOBILE_GOOGLE_AUTH_ENABLED=false
MOBILE_GOOGLE_REGISTRATION_ENABLED=false
MOBILE_GOOGLE_REGISTRATION_AUTO_ACTIVATE=false
GOOGLE_OAUTH_WEB_CLIENT_ID=
GOOGLE_OAUTH_CERTS_URL=https://www.googleapis.com/oauth2/v1/certs
GOOGLE_OAUTH_TIMEOUT_SECONDS=8
